# レシート読み取り（主の経路）。なくても予備の経路（端末内のOCR）で動く
GEMINI_API_KEY=
# 任意：使うモデル（未指定なら gemini-3.8-flash）
# GEMINI_MODEL=gemini-3.8-flash
# 任意：Claude API に切り替えるとき（RECEIPT_ENGINE=claude）
# RECEIPT_ENGINE=gemini
# ANTHROPIC_API_KEY=
PORT=8000
# 0 にするとデモ用のボタンを隠す
DEMO_MODE=1
# HTTPS（python -m server.make_cert で作ると自動で書き込まれる）
# SSL_CERT=var/cert.pem
# SSL_KEY=var/key.pem
# 開発者メニュー（アプリ名を3秒長押し）のパスワード
DEBUG_PASSWORD=
